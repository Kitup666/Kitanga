{
  "productName": "Kitanga",
  "version": "1.0.0",
  "identifier": "com.kitanga.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kitanga - 漫画拼接工具",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
